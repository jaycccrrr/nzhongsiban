---
const { title = '', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['', '总览'],
  ['members', '人物录'],
  ['relation', '关系图谱'],
  ['fun', '趣味榜'],
  ['timeline', '大事记'],
  ['gallery', '照片墙'],
  ['memes', '梗百科'],
];
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{title ? title + ' · ' : ''}廿中四班</title>
<style>
:root{
  --bg:#faf6ee; --bg2:#f4ecdd; --card:#fffdf8; --line:#e8ddc9;
  --ink:#3d362e; --dim:#8a7f6d; --dim2:#b3a88f;
  --terra:#c96f4a; --amber:#d9a441; --sage:#8a9a5b; --slate:#7a8fa6; --rose:#b56576;
  --serif:"Noto Serif SC","Songti SC","STSong",serif;
  --sans:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);min-height:100vh;line-height:1.7}
body::before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.5;
  background:radial-gradient(700px 300px at 10% -5%,#f3e3c8,transparent 60%),
             radial-gradient(600px 300px at 95% 5%,#f0dfd2,transparent 60%)}
a{color:var(--terra);text-decoration:none}
img{max-width:100%}
header.site{position:relative;text-align:center;padding:44px 16px 8px}
header.site h1{font-family:var(--serif);font-size:clamp(30px,7vw,44px);letter-spacing:10px;color:var(--ink)}
header.site h1::after{content:"";display:block;width:56px;height:3px;background:var(--terra);margin:14px auto 0;border-radius:2px}
header.site .sub{color:var(--dim);font-size:13px;margin-top:12px;letter-spacing:1px}
nav.site{position:sticky;top:0;z-index:50;display:flex;gap:2px;justify-content:center;flex-wrap:wrap;
  background:rgba(250,246,238,.9);backdrop-filter:blur(10px);padding:10px 8px;border-bottom:1px solid var(--line);margin-top:20px}
nav.site a{color:var(--dim);font-size:14px;padding:7px 15px;border-radius:999px;transition:.2s;letter-spacing:1px}
nav.site a:hover{color:var(--terra)}
nav.site a.on{color:#fff;background:var(--terra);font-weight:600}
main{position:relative;max-width:880px;margin:0 auto;padding:26px 16px 90px}
footer.site{text-align:center;color:var(--dim2);font-size:12px;padding:0 16px 44px;line-height:2;letter-spacing:1px}
/* ---- 通用组件 ---- */
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:26px 24px;margin-bottom:18px;
  box-shadow:0 2px 14px rgba(120,100,60,.06)}
.card h2{font-family:var(--serif);font-size:19px;letter-spacing:2px;margin-bottom:16px;color:var(--ink)}
.card h2::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--amber);margin-right:10px;vertical-align:2px}
.story{font-family:var(--serif);font-size:16.5px;line-height:2.1;color:#5a5142}
.story b{color:var(--terra);font-weight:700}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.bignum{text-align:center;padding:22px 8px}
.bignum .v{font-family:var(--serif);font-size:clamp(28px,6vw,38px);font-weight:700;color:var(--terra)}
.bignum .k{color:var(--dim);font-size:12.5px;margin-top:6px;letter-spacing:1px}
.bar-row{display:flex;align-items:center;gap:10px;margin:9px 0;font-size:13.5px}
.bar-row .lb{flex:0 0 86px;color:var(--dim);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-row .track{flex:1;height:10px;background:var(--bg2);border-radius:6px;overflow:hidden}
.bar-row .fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--amber),var(--terra));min-width:3px}
.bar-row .vl{flex:0 0 56px;color:var(--dim);font-size:12px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--bg2);border:1px solid var(--line);border-radius:999px;padding:5px 14px;font-size:13px;color:var(--dim)}
.chip b{color:var(--ink)}
.mchart{display:flex;align-items:flex-end;gap:6px;height:120px;padding-top:8px}
.mchart .mb{flex:1;background:linear-gradient(180deg,var(--amber),#eed9ae);border-radius:5px 5px 0 0;min-height:3px;transition:.2s}
.mchart .mb:hover{background:var(--terra)}
.mchart-lb{display:flex;gap:6px;font-size:10.5px;color:var(--dim2);margin-top:6px}
.mchart-lb span{flex:1;text-align:center}
.hint{font-size:12.5px;color:var(--dim2);margin-top:10px;text-align:center;letter-spacing:.5px}
/* ---- 人物 ---- */
.mgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.mcard{display:block;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;color:var(--ink);transition:.25s;box-shadow:0 2px 10px rgba(120,100,60,.05)}
.mcard:hover{transform:translateY(-4px);box-shadow:0 10px 28px rgba(160,110,60,.15);border-color:var(--amber)}
.mcard .top{display:flex;align-items:center;gap:13px}
.avatar{width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:22px;font-weight:700;color:#fff;flex:0 0 54px;font-family:var(--serif);overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
.mcard .nm{font-size:17px;font-weight:700;font-family:var(--serif);letter-spacing:1px}
.mcard .rl{font-size:11.5px;color:var(--dim2);margin-top:2px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;min-height:24px}
.tag{font-size:11.5px;padding:3px 11px;border-radius:999px;background:#f6ecd8;color:#a0763a;border:1px solid #ecdcc0}
.mcard .one{margin-top:12px;font-size:13px;color:var(--dim);line-height:1.8;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* ---- 时间线 ---- */
.tl{position:relative;padding-left:26px}
.tl::before{content:"";position:absolute;left:7px;top:8px;bottom:8px;width:2px;background:linear-gradient(180deg,var(--amber),var(--terra));border-radius:1px}
.tl .ev{position:relative;margin-bottom:20px}
.tl .ev::before{content:"";position:absolute;left:-24px;top:8px;width:11px;height:11px;border-radius:50%;background:var(--amber);border:2px solid var(--card);box-shadow:0 0 0 2px var(--amber)}
.tl .d{color:var(--terra);font-size:12.5px;font-weight:700;letter-spacing:1px}
.tl .t{font-family:var(--serif);font-size:16.5px;font-weight:700;margin:2px 0 4px}
.tl .b{font-size:14px;color:#5a5142;line-height:1.9}
.tl .b img{border-radius:12px;margin-top:8px}
/* ---- 照片墙 ---- */
.gsec{font-family:var(--serif);font-size:16px;letter-spacing:2px;color:var(--dim);margin:22px 0 12px}
.ggrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.ggrid .ph{aspect-ratio:1;border-radius:14px;overflow:hidden;background:var(--bg2);cursor:pointer;border:1px solid var(--line)}
.ggrid img{width:100%;height:100%;object-fit:cover;transition:.3s}
.ggrid .ph:hover img{transform:scale(1.06)}
#lightbox{position:fixed;inset:0;z-index:100;background:rgba(40,32,20,.9);display:none;align-items:center;justify-content:center;padding:20px;cursor:zoom-out}
#lightbox.on{display:flex}
#lightbox img{max-width:100%;max-height:100%;border-radius:12px}
/* ---- 梗百科 ---- */
.meme h3{font-family:var(--serif);font-size:18px;letter-spacing:1px}
.meme .md{font-size:12px;color:var(--dim2);margin:2px 0 8px}
.meme .bd{font-size:14.5px;color:#5a5142;line-height:1.9}
/* ---- 内容段落 ---- */
.prose{font-size:15px;line-height:2;color:#5a5142}
.prose p{margin-bottom:10px}
.prose ul{padding-left:20px;margin-bottom:10px}
.prose img{border-radius:12px;margin:8px 0}
@media (max-width:640px){
  .grid3{grid-template-columns:repeat(3,1fr);gap:8px}
  .card{padding:20px 16px}
  main{padding:18px 12px 80px}
  .bar-row .lb{flex-basis:70px}
  header.site h1{letter-spacing:6px}
}
</style>
</head>
<body>
<header class="site">
  <h1>廿中四班</h1>
  <div class="sub">十二个人的一年 · 数据里的我们</div>
</header>
<nav class="site">
  {nav.map(([p, n]) => <a href={base + '/' + p + (p ? '/' : '')} class={current === p ? 'on' : ''}>{n}</a>)}
</nav>
<main><slot /></main>
<footer class="site">
  廿中四班 · 義朝元老一周年纪念<br>
  所有内容仅限群内浏览 · 数据统计于本地完成，原始聊天记录不离开本机
</footer>
<div id="lightbox" onclick="this.classList.remove('on')"><img alt=""></div>
<script is:inline>
/* 加密部署模式下：用会话密钥解密 photos 图片（本地开发时 gk 不存在，自动跳过） */
(function(){
  var gk=sessionStorage.getItem('gk');
  if(!gk)return;
  function unhex(h){var a=new Uint8Array(h.length/2);for(var i=0;i<a.length;i++)a[i]=parseInt(h.substr(i*2,2),16);return a}
  function b2b(b){var s=atob(b),a=new Uint8Array(s.length);for(var i=0;i<s.length;i++)a[i]=s.charCodeAt(i);return a}
  var keyP=crypto.subtle.importKey('raw',unhex(gk),'AES-GCM',false,['decrypt']);
  document.querySelectorAll('img').forEach(function(im){
    var src=im.getAttribute('src');
    if(!src||src.indexOf('/photos/')<0)return;
    keyP.then(function(key){
      return fetch(src+'.enc').then(function(r){return r.text()}).then(function(t){
        var raw=b2b(t);
        return crypto.subtle.decrypt({name:'AES-GCM',iv:raw.slice(16,28)},key,raw.slice(28));
      }).then(function(buf){
        var type=/\.png$/i.test(src)?'image/png':(/\.webp$/i.test(src)?'image/webp':(/\.gif$/i.test(src)?'image/gif':'image/jpeg'));
        im.src=URL.createObjectURL(new Blob([buf],{type:type}));
      });
    }).catch(function(){});
  });
})();
</script>
<script is:inline>
document.querySelectorAll('.ggrid img').forEach(im=>{
  im.closest('.ph').addEventListener('click',()=>{
    const lb=document.getElementById('lightbox');
    lb.querySelector('img').src=im.src;
    lb.classList.add('on');
  });
});
</script>
</body>
</html>
