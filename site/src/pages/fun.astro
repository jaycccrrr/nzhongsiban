---
import Layout from '../layouts/Layout.astro';
import { stats as D, fmt, esc } from '../lib/data.js';
---
<Layout title="趣味榜" current="fun">
  <div class="card">
    <h2>群名变迁史</h2>
    <div class="tl">
      {D.renames.map(r => (
        <div class="ev">
          <div class="d">{r.date}</div>
          <div class="b">{esc(r.text)}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="card">
    <h2>话题终结者</h2>
    <p class="story" style="margin-bottom:12px;font-size:14.5px">说完一句话，群里安静了两个小时以上的次数——</p>
    {D.silenceKings.map(([s, c]) => (
      <div class="bar-row"><div class="lb">{esc(s)}</div><div class="track"><div class="fill" style={`width:${c / D.silenceKings[0][1] * 100}%`}></div></div><div class="vl">{c} 次</div></div>
    ))}
    <div class="hint">其实也可能只是 TA 说完大家就安心去睡了</div>
  </div>

  <div class="card">
    <h2>年度表情</h2>
    {D.emojis.slice(0, 8).map(([e, c]) => (
      <div class="bar-row"><div class="lb">[{esc(e)}]</div><div class="track"><div class="fill" style={`width:${c / D.emojis[0][1] * 100}%`}></div></div><div class="vl">{fmt(c)}</div></div>
    ))}
  </div>

  <div class="card">
    <h2>关键词里的这一年</h2>
    <div class="chips">
      {D.keywords.map(([k, c]) => <span class="chip"><b>{esc(k)}</b> ×{fmt(c)}</span>)}
    </div>
  </div>
</Layout>
