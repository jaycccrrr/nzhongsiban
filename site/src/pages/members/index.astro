---
import Layout from '../../layouts/Layout.astro';
import { stats as D, members, fmt, esc, pcolor, deriveTags, personStory } from '../../lib/data.js';
const TAGS = deriveTags(D);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const byId = Object.fromEntries(members.map(m => [m.name, m]));
const cards = D.persons.map((p, i) => ({ p, i, m: byId[p.name] || {} }));
---
<Layout title="人物录" current="members">
  <div class="mgrid">
    {cards.map(({ p, i, m }) => (
      <a class="mcard" href={`${base}/members/${m.id || i}/`}>
        <div class="top">
          <div class="avatar" style={`background:${pcolor(i)}`}>
            {m.avatar ? <img src={`${base}/${m.avatar}`} alt={p.name} loading="lazy"> : p.name[0]}
          </div>
          <div>
            <div class="nm">{p.name}</div>
            <div class="rl">{fmt(p.msgs)} 条发言</div>
          </div>
        </div>
        <div class="tags">
          {(m.tags || []).map(t => <span class="tag">{t}</span>)}
          {(TAGS[p.name] || []).map(t => <span class="tag">{t}</span>)}
        </div>
        <div class="one">{personStory(p, D)}</div>
      </a>
    ))}
  </div>
  <div class="hint">点击卡片，看看 TA 这一年的样子</div>
</Layout>
